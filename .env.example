# ── Phase 1 (required) ───────────────────────────────────────────────
# Copy this file to .env.local and fill in both values.
# Find them in Supabase → Project Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Phase 1 needs NO service-role key: every query runs as the signed-in
# user through Postgres Row Level Security.

# ── Phase 2 — AI Assistant (required for /assistant) ────────────────
# Free key from https://aistudio.google.com (Google AI Studio).
# SERVER-SIDE ONLY — deliberately NOT prefixed with NEXT_PUBLIC_,
# so it never reaches the browser.
GEMINI_API_KEY=
# Optional: free tier only serves Flash models (Pro was removed from
# the free tier in April 2026). Change only if your key allows another.
GEMINI_MODEL=gemini-2.0-flash

# ── Phase 4 — WhatsApp (Meta Cloud API, SANDBOX TEST NUMBER ONLY) ──
# All server-side only. From Meta App Dashboard → WhatsApp → API Setup:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose — must match the value entered in the
# webhook settings of your Meta app:
WHATSAPP_VERIFY_TOKEN=
# FAIL-CLOSED safety net: comma-separated test numbers (the ones you
# verified in Meta's "To" field). EMPTY = sending disabled entirely.
WHATSAPP_ALLOWED_RECIPIENTS=
# Optional (default v23.0):
# WHATSAPP_API_VERSION=v23.0
# Service-role key — used ONLY by the webhook handler (Meta's servers
# call it with no user session). Server-side only, never NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 5 — Billing (STRIPE TEST MODE ONLY — the app rejects any
#    key that doesn't start with sk_test_) ────────────────────────────
STRIPE_SECRET_KEY=
# A recurring price created in your Stripe test dashboard:
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook`
# (Stripe CLI, free) or the test-mode webhook in the dashboard:
STRIPE_WEBHOOK_SECRET=

# ── Later phases (leave blank for now) ───────────────────────────────
# CRON_SECRET=                 # pg_cron → /api/cron/* shared secret
